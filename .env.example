# Variables para docker-compose.yml / docker-compose.override.yml.
# Copiar a ".env" en la raiz del proyecto (NO se versiona) y ajustar valores.
# En produccion, generar valores fuertes y unicos - nunca reutilizar los de aqui.

APP_ENV=local

DB_DATABASE=vera
DB_USERNAME=vera
DB_PASSWORD=cambia_esta_password
DB_ROOT_PASSWORD=cambia_esta_password_root

MEILISEARCH_KEY=cambia_esta_master_key

# Solo relevante en produccion (docker-compose.yml sin el override de
# desarrollo). En desarrollo, docker-compose.override.yml fija REDIS_HOST=redis
# automaticamente y este valor se ignora.
REDIS_HOST=host.docker.internal
